    function State:SelectTab(tab)
        if self.CurrentTab == tab then return end
        
        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Sine)
        
        if self.CurrentTab then
            local oldTab = self.CurrentTab
            PlayTween(oldTab.Button, tweenInfo, {BackgroundTransparency = 0.75})
            PlayTween(oldTab.Button.Title, tweenInfo, {Position = UDim2.new(0.525, 0, 0.5, 0)})
            PlayTween(oldTab.Button.Icon, tweenInfo, {Position = UDim2.new(0.15, 0, 0.5, 0)})
            
            oldTab.Content.GroupTransparency = 1
            oldTab.Content.Visible = false
            oldTab.Content.Parent = nil
        end
        
        self.CurrentTab = tab
        
        tab.Content.Parent = self.TabFrame.Parent
        tab.Content.Visible = true
        
        PlayTween(tab.Button, tweenInfo, {BackgroundTransparency = 0})
        PlayTween(tab.Button.Title, tweenInfo, {Position = UDim2.new(0.55, 0, 0.5, 0)})
        PlayTween(tab.Button.Icon, tweenInfo, {Position = UDim2.new(0.175, 0, 0.5, 0)})
        
        PlayTween(tab.Content, tweenInfo, {GroupTransparency = 0})
    end

