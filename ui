                value = math.clamp(value, min, max)
                current = value
                local percent = (value - min) / (max - min)
                local pos = percent * 400
                button.Position = UDim2.new(0, pos, 0.5, 0)
                filler.Size = UDim2.new(0, pos, 0, 5)
                valueBox.Text = tostring(math.floor(value))
                if callback then callback(value) end
            end
            
            UpdateSlider(default)
            
            local dragging = false
            button.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    local offset = button.AbsolutePosition.X - button.Position.X.Offset
                    
                    local connection
                    connection = RunService.RenderStepped:Connect(function()
                        if dragging then
                            local pos = math.clamp(Mouse.X - offset - 3, 0, 400)
                            local value = min + (max - min) * (pos / 395)
                            UpdateSlider(value)
                        end
