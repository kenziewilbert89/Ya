    function PlayTouchSound()
        -- Play a touch sound effect
    end

    function ApplyTouchEffect(button)
        button.MouseButton1Click:Connect(function()
            local effect = MakeInstance("Frame", {
                Name = "TouchEffect",
                Parent = button,
                BackgroundTransparency = 0.9999,
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.new(0, 0, 0, 0),
            })
            
            MakeInstance("UICorner", {
                CornerRadius = UDim.new(0, 15),
            }, effect)
            
            local stroke = MakeInstance("UIStroke", {
                Name = "UIStroke",
                Transparency = 0,
                Color = Color3.fromRGB(255, 255, 255),
                Thickness = 1.5,
                Enabled = true,
            }, effect)
            
            local tweenInfo = TweenInfo.new(0.75, Enum.EasingStyle.Quad)
            effect.Position = UDim2.new(0, Mouse.X - button.AbsolutePosition.X, 0, Mouse.Y - button.AbsolutePosition.Y)
            effect.Size = UDim2.new(0, 30, 0, 30)
            
            PlayTween(effect, tweenInfo, {Size = UDim2.new(0, 60, 0, 60)})
            PlayTween(stroke, tweenInfo, {Transparency = 1})
            
            task.wait(0.75)
            effect:Destroy()
        end)
    end

    -- ============================================
    -- TOGGLE UI FUNCTION
    -- ============================================

    local isOpen = false
    local toggleTweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Sine)
    
    function State:ToggleUI()
        PlayTouchSound()
        isOpen = not isOpen
        
        if isOpen then
            self.MainFrame.Visible = true
            PlayTween(self.MainFrame, toggleTweenInfo, {
                Position = UDim2.new(0.5, 0, 0.5, 0),
                Size = UDim2.new(0, 600, 0, 300)
            })
        else
            PlayTween(self.MainFrame, toggleTweenInfo, {
                Position = UDim2.new(0.5, 0, -0.5, 0),
                Size = UDim2.new(0, 30, 0, 30)
            })
            task.wait(0.25)
            self.MainFrame.Visible = false
        end
    end

    -- ============================================
    -- NOTIFICATION SYSTEM
    -- ============================================

    function State:Notify(message)
        local notification = MakeInstance("Frame", {
            Name = "Notification",
            Parent = self.NotificationContainer,
            BackgroundTransparency = 1,
            BackgroundColor3 = Color3.fromRGB(20, 20, 20),
            Size = UDim2.new(0, 250, 0, 0),
