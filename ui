        })
        
        MakeInstance("UICorner", {
            CornerRadius = UDim.new(0, 5),
        }, notification)
        
        local stroke = MakeInstance("UIStroke", {
            Name = "UIStroke",
            Transparency = 0.55,
            Color = self.CurrentTheme.USC,
            Thickness = 2,
            Enabled = true,
        }, notification)
        
        local title = MakeInstance("TextLabel", {
            Name = "Title",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 5),
            Size = UDim2.new(1, -20, 0, 25),
            RichText = true,
            Font = Enum.Font.Gotham,
            Text = "Overdrive H Says:",
            TextSize = 14,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextXAlignment = Enum.TextXAlignment.Left,
        }, notification)
        
        local desc = MakeInstance("TextLabel", {
            Name = "Description",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 30),
            Size = UDim2.new(1, -20, 0, 0),
            RichText = true,
            Font = Enum.Font.Gotham,
            Text = message,
            TextSize = 11,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
        }, notification)
        
        -- Animate in
        local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Quint)
        notification.Size = UDim2.new(0, 250, 0, 40 + desc.TextBounds.Y)
        PlayTween(notification, tweenInfo, {BackgroundTransparency = 0.5})
        
        -- Auto hide after 5 seconds
        task.wait(5)
        PlayTween(notification, tweenInfo, {BackgroundTransparency = 1, Size = UDim2.new(0, 250, 0, 0)})
        task.wait(0.5)
        notification:Destroy()
    end

    -- ============================================
    -- SETUP COMPLETE
    -- ============================================

    -- Setup minimize button
    MinimizeButton.MouseButton1Click:Connect(function()
        State:ToggleUI()
    end)

    -- Open UI initially
    task.wait(0.5)
    State:ToggleUI()

    return State
end

